#: src/milkdrop.rs:77
#, rust-format
msgid "{rate} fps, your screen"
msgstr "{rate} кадр/с, как у экрана"

#: src/model.rs:649
msgid "Last 4 weeks"
msgstr "Последние 4 недели"

#: src/model.rs:650
msgid "Last 6 months"
msgstr "Последние 6 месяцев"

#: src/model.rs:651
msgid "Past year"
msgstr "Последний год"

#: src/model.rs:660
msgid "Calculated from your listening over approximately the last 4 weeks."
msgstr "Рассчитано по вашим прослушиваниям примерно за последние 4 недели."

#: src/model.rs:664
msgid "Calculated from your listening over approximately the last 6 months."
msgstr "Рассчитано по вашим прослушиваниям примерно за последние 6 месяцев."

#: src/model.rs:668
msgid "Calculated from several years of listening history."
msgstr "Рассчитано по истории прослушиваний за несколько лет."

#: src/model.rs:803 src/model.rs:939
msgctxt "filter"
