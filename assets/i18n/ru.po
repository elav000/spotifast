msgstr "Держит мини-плеер поверх всех остальных окон."

#: src/ui/settings.rs:2064 src/ui/winamp/mod.rs:787
msgid "Show in taskbar"
msgstr "Показывать на панели задач"

#: src/ui/settings.rs:2067
