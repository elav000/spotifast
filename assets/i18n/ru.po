msgstr "Проверить обновления"

#: src/ui/settings.rs:2695 src/ui/dialogs.rs:156 src/ui/keys.rs:422
#: src/ui/topbar.rs:536
msgid "Keyboard shortcuts"
msgstr "Сочетания клавиш"

