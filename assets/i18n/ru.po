msgid "Not using a proxy."
msgstr "Прокси не используется."

#: src/ui/settings.rs:1983
msgid "Using the system proxy."
msgstr "Используется системный прокси."

#: src/ui/settings.rs:1995 src/ui/keys.rs:390
msgid "Mini player"
msgstr "Мини-плеер"

#: src/ui/settings.rs:1996 src/ui/winamp/mod.rs:777 src/ui/winamp/mod.rs:923
msgid "Always on top"
msgstr "Поверх всех окон"

#: src/ui/settings.rs:1997
msgid "Show the mini player in taskbar"
msgstr "Показывать мини-плеер на панели задач"

#: src/ui/settings.rs:1998
msgid "Random skin"
msgstr "Случайный скин"

#: src/ui/settings.rs:1999
